# ============================================================
#  Algo Hunt — Trading Alert Platform · environment configuration
#  Local dev: copy to `.env.local`.  Vercel: add each variable in
#  Project → Settings → Environment Variables.
# ============================================================

# ---- Database ----
# Postgres — normally Neon (free plan). The app runs as one process and keeps live state in
# memory, so Neon only receives core records (strategies, connections, settings, alerts,
# alerting signals, paper trades, the Kite session). Migrations run on `npm run setup` /
# `npm run build` / `npm run dev`. On Vercel use Neon's *pooled* string (host has "-pooler").
#   e.g. postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
#
# Left empty: a local file instead, data/algo-hunt.db (SQLite built into Node.js;
# a snapshot a day in backups/; both git-ignored).
# DATABASE_FILE=data/algo-hunt.db
# BACKUP_DIR=backups

# ---- Live worker ----
# The app (`npm start` and `npm run dev`) runs the live worker inside itself: streaming Kite,
# alerts seconds after each candle close. LIVE_WORKER=off runs the app without it (then
# `npm run live` separately) — the app then reads everything from the database (more traffic).
# LIVE_WORKER=on

# ---- Zerodha Kite Connect (required) ----
# From https://developers.kite.trade/apps. Set the app's Redirect URL to
#   https://<your-domain>/zerodhaRedirection
# The daily access token is obtained through the in-app "Connect Kite" login
# and stored (encrypted) in the database — there is no token variable.
KITE_API_KEY=
KITE_API_SECRET=

# ---- Access control (required for `npm start`) ----
# Password for the dashboard login page.
APP_PASSWORD=
# Shared secret for the scheduler that calls /api/cron/tick every minute
# (the V2 scanner; it only backs up the local live worker while that runs).
# Vercel Cron sends it automatically as "Authorization: Bearer $CRON_SECRET".
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Optional: Telegram alerts (delivered even with no dashboard open) ----
# Chats are best managed in V2 → Settings (several people / groups, with names).
# TELEGRAM_CHAT_ID is the fallback when that list is empty; comma-separate several.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789,987654321

# ---- Optional: V2 email alerts via Resend (https://resend.com) ----
# Recipients and sender are set in V2 → Settings.
# RESEND_API_KEY=re_...

# ---- Optional ----
# LOG_LEVEL=info   # error | warn | info | debug
