# ============================================================
#  ASH — Trading Alert Platform · environment configuration
#  Copy to `.env` (used by the server). Nothing here is required
#  to run the demo: with no DATABASE_URL and MARKET_PROVIDER=mock
#  the platform runs fully in-memory on simulated market data.
# ============================================================

# ---- HTTP / WebSocket server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Market data provider ----
# "mock" = built-in simulated tick generator (default, no credentials).
# "kite" = Zerodha Kite Connect live WebSocket (requires the KITE_* vars).
MARKET_PROVIDER=mock
MOCK_TICK_INTERVAL_MS=1000

# ---- Database (optional) ----
# Neon / any Postgres. If omitted, an in-memory store is used so the
# app still runs; alert history/analytics simply reset on restart.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Zerodha Kite Connect (only when MARKET_PROVIDER=kite) ----
# Kite is a paid API; the access token is generated daily via the login flow.
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=

# ---- Strategy defaults ----
RSI_PERIOD=14
