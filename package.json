{
  "name": "ash-alert-platform",
  "private": true,
  "version": "0.2.0",
  "description": "Personal trading alert platform for Indian markets \u2014 strategies + products = alerts, paper trading, backtests (Next.js + Zerodha Kite + Postgres on Neon)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "predev": "node scripts/migrate.mjs --if-configured --soft",
    "dev": "next dev",
    "build": "node scripts/migrate.mjs --if-configured && next build",
    "start": "next start",
    "update": "git pull --ff-only && npm install && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "live": "node scripts/migrate.mjs --if-configured --soft && tsx src/server/workers/v2Live.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "kiteconnect": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
