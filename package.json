{
  "name": "ash-alert-platform",
  "private": true,
  "version": "0.2.0",
  "description": "Real-time RSI synchronized multi-instrument trading alert platform (Next.js + Zerodha Kite + Neon)",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/migrate.mjs --if-configured --soft",
    "dev": "next dev",
    "build": "node scripts/migrate.mjs --if-configured && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "kiteconnect": "^4.1.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
